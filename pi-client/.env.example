# URL of the deployed status API (server/ folder). Use your cloud host in production.
API_BASE_URL=http://localhost:4000

# Must match one of the professor ids in server/src/store.js
DEVICE_ID=aris-thorne

# Per-device secret — copy from server/devices.json for this professor
API_KEY=CHANGE-ME

# How often (seconds) the Pi re-checks the cloud in case status was changed
# remotely from the web app instead of the physical door control.
REFRESH_SECONDS=20
