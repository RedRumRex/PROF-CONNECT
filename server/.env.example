# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call the API / connect via websocket.
# Add your deployed frontend URL in production.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Path (relative to the server/ folder) to the JSON file mapping
# professorId -> per-device API key. Copy devices.example.json to
# devices.json and set real secrets before deploying.
DEVICE_KEYS_FILE=./devices.json

# Optional master key that can update ANY professor's status (used by the
# professor's own web dashboard when they toggle availability manually,
# as opposed to the Pi device pushing it automatically).
ADMIN_KEY=change-this-admin-key

# Supabase project (student/teacher/appointment/*_auth tables — see db/schema.sql).
# Use the SERVICE ROLE key here, not the anon key — this backend writes
# directly to auth tables and must bypass RLS. Never expose this key to
# the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT signing secret for issued login tokens. Generate a real random value
# for production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRE_MINUTES=1440
